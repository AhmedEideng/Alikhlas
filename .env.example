# ============================================================
# Al Ikhlas Medical — Environment Variables
# ============================================================
# المتغيرات المطلوبة لتشغيل المشروع (Vercel أو نشر ذاتي)
# ============================================================

# ── مطلوب ──────────────────────────────────────────────────────
# رابط Google Apps Script Web App لاستقبال الطلبات والمراجعات
# (في محرر Apps Script: Deploy → Web app → URL)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/replace-with-deployment-id/exec

# URL الموقع الرسمي (canonical + OG tags + feeds)
SITE_URL=https://alikhlasmedical.store

# ── مطلوب لتفعيل المراجعات الحقيقية ───────────────────────────
# مفتاح HMAC لقراءة المراجعات — يجب أن يطابق حرفياً قيمة
# REVIEW_READ_TOKEN في google-apps-script.gs (نفس السلسلة في الطرفين)
# بدونها: قسم "تجارب حقيقية من عملائنا" معطّل بصمت (fail-closed)
# والموقع يعمل طبيعيًا
GOOGLE_SHEETS_REVIEWS_TOKEN=replace-with-the-same-value-as-REVIEW_READ_TOKEN

# ── إلزامي ───────────────────────────────────────────────────
# سر كتابة مشترك للـ webhook — يجب أن يطابق WEBHOOK_SECRET في
# google-apps-script.gs (نفس السلسلة في الطرفين).
# ⚠️ إلزامي: doPost في Apps Script يعمل Fail Closed — بدون السر
# تُرفض كل عمليات الكتابة (لا يوجد وضع قديم/legacy).
# ترتيب التفعيل الآمن: (1) ضعي المتغير هنا + Redeploy،
# (2) بعدها عبّئي WEBHOOK_SECRET في السكربت + New version.
GOOGLE_SHEETS_WEBHOOK_SECRET=replace-with-a-long-random-secret

# منفذ أخطاء متوافق مع Sentry (بدونه: console فقط في dev)
# VITE_ERROR_SINK_URL=

# Port — للنشر الذاتي فقط (الافتراضي 8080)
# PORT=8080

# ── للنشر الذاتي (self-hosted) ──────────────────────────────
# عدد البروكسيات الموثوقة أمام الخادم (nginx/Caddy = 1، Cloudflare + nginx = 2).
# بدونه: كل الزوار يتشاركون مفتاح حدّ واحد (30 طلبًا/دقيقة للموقع كله) لأن
# عنوان المقبس هو عنوان البروكسي نفسه — والخادم يطبع تحذيرًا عند الإقلاع.
# لا تضبطه إذا كان الخادم مكشوفًا مباشرة (وإلا صار X-Forwarded-For قابلًا للتزوير).
# TRUST_PROXY_HOPS=1

# URL ثابت لتقارير CSP (Report-To). بدونها السيرفر بيستخدم
# SITE_URL (النطاق الرسمي)، ولو مفيش SITE_URL كمان بيشتغل
# على الـ origin الفعلي للطلب (dev فقط).
# في Vercel: مش مطلوب — الـ endpoint ثابت في vercel.json.
# CSP_REPORT_ENDPOINT=https://alikhlasmedical.store/api/csp-report

# ── اختياري — تحليلات الزيارات (GA4) ─────────────────────────
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# GA_API_SECRET=

# ── سكريبتات CI/محلية فقط — لا يحتاجها Vercel ────────────────
# مفتاح Gemini لخط توليد المقالات وفحص دعم الادعاءات بالمصادر
# GEMINI_API_KEY=

# ── التواصل والتحليلات (تُحقن وقت البناء في 110 صفحة) ─────────
# رقم الواتساب الفعلي بصيغة دولية بلا + (مثال: 201012345678).
# الرقم الفعلي الحالي (201146044715) مثبّت في `.env.production` ويُقرأ وقت البناء.
# اتركه فارغًا هنا = يبقى رقم الاختبار البديل.
VITE_WHATSAPP_NUMBER=

# معرّف GA4 (G-XXXXXXXXXX). فارغ = التحليلات معطّلة بلا أخطاء.
VITE_GA_ID=
