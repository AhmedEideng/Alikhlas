# رقم واتساب المتجر الفعلي (صيغة دولية بلا +)
# يُقرأ عبر src/lib/site-config.ts ويُحقن في كل صفحة وقت البناء.
# يمكن تجاوزه من لوحة النشر عبر VITE_WHATSAPP_NUMBER.
VITE_WHATSAPP_NUMBER=201146044715

# حاوية Google Tag Manager. فارغة الآن عن قصد: القناة المفعّلة هي GA4 مباشرة
# (VITE_GA_ID أدناه)، وتشغيل الاثنين معًا يجعل الأحداث تُستهلك بلا مُرسل.
# لتفعيل GTM: ضع GTM-M4M8HHJT هنا وأفرغ VITE_GA_ID.
VITE_GTM_ID=

# معرّف قياس GA4 (خاصية «الإخلاص ميديكال»). يُقرأ في meta ويحمّله ga-loader.
VITE_GA_ID=G-FTZG9H6DJX
